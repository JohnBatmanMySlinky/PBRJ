    "# Define the radius\n",
    "radius = 1.44224957031\n",
    "\n",
    "# Generate points for the circle\n",
    "theta = np.linspace(0, 2 * np.pi, 100)\n",
    "# x = (radius * np.cos(theta) + circle_translate.x) * circle_scale.x\n",
    "# z = (radius * np.sin(theta) + circle_translate.z) * circle_scale.z\n",
    "\n",
    "x = (radius * np.cos(theta) * circle_scale.x + circle_translate.x) \n",
    "z = (radius * np.sin(theta) * circle_scale.z + circle_translate.z)\n",
    "\n",
    "corners_x = [bbox_pmin.x, bbox_pmax.x, bbox_pmax.x, bbox_pmin.x, bbox_pmin.x]\n",
    "corners_z = [bbox_pmin.z, bbox_pmin.z, bbox_pmax.z, bbox_pmax.z, bbox_pmin.z]\n",
    "\n",
    "# Plot the circle\n",
    "plt.figure(figsize=(6,6))\n",
    "plt.plot(x, z, 'r-')\n",
    "\n",
    "# plot the square\n",
    "plt.plot(corners_x, corners_z, 'b-')\n",
    "plt.fill(corners_x, corners_z, 'lightblue')\n",
    "\n",
    "# plot the ray\n",
    "plt.arrow(ray_o.x, ray_o.z, ray_o.x + ray_t * ray_d.x, ray_o.z + ray_t * ray_d.z, head_width=30, head_length=30, fc='orange', ec='orange')\n",
    "\n",
    "# options\n",
    "plt.gca().set_aspect('equal', adjustable='box')\n",
    "plt.title(f'The World')\n",
    "plt.xlabel('X')\n",
    "plt.ylabel('Z')\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
