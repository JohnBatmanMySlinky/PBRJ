   "source": [
    "X = []\n",
    "Y = []\n",
    "for x in 0:.001:1\n",
    "    x, y = RayTracing.demux_float(Float32(x))\n",
    "    push!(X,x)\n",
    "    push!(Y,y)\n",
    "end"
   ]
