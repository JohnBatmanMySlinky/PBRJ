Integrator "volpath"
    "integer maxdepth" [ 10 ]
Sampler "paddedsobol"
    "integer pixelsamples" [ 256 ]
PixelFilter "gaussian"
Film "rgb"
    "float iso" [ 700 ]
    "string filename" [ "smoke.exr" ]
    "float cropwindow" [ 0 0.9 0 0.8 ]
    "integer xresolution" [ 900 ]
    "integer yresolution" [ 900 ]
Scale -1 1 1
LookAt 0.0715308 -4.17677 5.33558
    0.0720194 -3.62456 4.50187
    -0.000323605 0.833706 0.552208
Camera "perspective"
    "float fov" [ 15 ]


WorldBegin


AttributeBegin
    LightSource "infinite"
        "float scale" [3]
        "string filename" "/Users/johnmyslinski/Documents/pbrt-v3-scenes/cloud/textures/skylight-morn_v4.exr"
AttributeEnd

AttributeBegin
    CoordSysTransform "camera"
    Material "diffuse"
        "rgb reflectance" [ 0.1 0.1 0.1 ]
    Translate 0 0 30
    Shape "disk"
        "float radius" [ 30 ]
AttributeEnd
AttributeBegin
    Translate -1 0 -1.2
    Rotate 90 1 0 0
    Include "/Users/johnmyslinski/Documents/pbrt-v3-scenes/cloud/geometry/density_render.70_v4.pbrt"
    "spectrum sigma_a" [300 20 830 20] 
	"spectrum sigma_s" [300 160 830 160]
AttributeEnd

AttributeBegin
    Translate -1 0 -1.2
    Rotate 90 1 0 0
    Material "interface"
    MediumInterface "smoke" ""
    Shape "plymesh"
        "string filename" [ "/Users/johnmyslinski/Documents/pbrt-v3-scenes/cloud/geometry/density_render.ply" ]
AttributeEnd

AttributeBegin
    Material "diffuse"
        "rgb reflectance" [ 0.5 0.5 0.5 ]
    Translate 0 0 -1
    Scale 100 100 100
    #    Shape "trianglemesh" "point3 P" [-10 -10 0 10 -10 0 10 10 0 -10 10 0] "integer indices" [0 2 1 0 3 2]
AttributeEnd
