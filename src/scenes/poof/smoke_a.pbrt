Integrator "bdpt"

Sampler "02sequence" "integer pixelsamples" [16]

PixelFilter "gaussian"

Film "image" "integer yresolution" [900] "integer xresolution" [900]
  "string filename" "smoke_a.exr"
  "float scale" 7

Scale -1 1 1
LookAt 0.0715308 -4.17677 5.33558 0.0720194 -3.62456 4.50187 -0.000323605 0.833706 0.552208
Camera "perspective" "float fov" [15]

WorldBegin
AttributeBegin
    LightSource "infinite" "string mapname" ["/Users/johnmyslinski/Documents/pbrt-v3-scenes/cloud/textures/skylight-morn.exr"]
        "color scale" [3 3 3]
AttributeEnd

AttributeBegin
CoordSysTransform "camera"
Material "matte" "color Kd" [.1 .1 .1]
Translate 0 0 30
Shape "disk" "float radius" 30
AttributeEnd

TransformBegin
	Translate -1 0 -1.2
	Rotate 90 1 0 0
	Include "/Users/johnmyslinski/Documents/pbrt-v3-scenes/cloud/geometry/density_render.70.pbrt"
	  "color sigma_a" [90 90 90] "color sigma_s" [10 10 10]
TransformEnd

AttributeBegin
	Translate -1 0 -1.2
  Translate 1.25 0 0 
	Rotate 90 1 0 0
    Material ""
    MediumInterface "smoke" ""
	Shape "sphere" "float radius" 1.4
AttributeEnd

AttributeBegin
    Material "matte" "color Kd" [0.5 0.5 0.5]
    Translate 0.0 0.0 -1.0
    Scale 100.0 100.0 100.0
#    Shape "trianglemesh" "point P" [-10 -10 0 10 -10 0 10 10 0 -10 10 0] "integer indices" [0 2 1 0 3 2]
AttributeEnd

WorldEnd

