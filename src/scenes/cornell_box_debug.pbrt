Integrator "bdpt" "integer maxdepth" [ 6 ]
Sampler "independent" "integer pixelsamples" [ 1 ]

Film "rgb"
    "string filename" [ "cornell-box.png" ]
    "integer yresolution" [ 500 ]
    "integer xresolution" [ 500 ]
    "float cropwindow" [.5 .502 .5 .502]

LookAt 278 278 -800   
       278 278 0   
       0 1 0 
Camera "perspective" "float fov" [ 40 ]


WorldBegin

MakeNamedMaterial "Floor"
    "string type" [ "diffuse" ]
    "rgb reflectance" [ 0.725 0.71 0.68 ]
MakeNamedMaterial "Ceiling"
    "string type" [ "diffuse" ]
    "rgb reflectance" [ 0.725 0.71 0.68 ]
MakeNamedMaterial "LeftWall"
    "string type" [ "diffuse" ]
    "rgb reflectance" [ 0.63 0.065 0.05 ]
MakeNamedMaterial "RightWall"
    "string type" [ "diffuse" ]
    "rgb reflectance" [ 0.14 0.45 0.091 ]
MakeNamedMaterial "BackWall"
    "string type" [ "diffuse" ]
    "rgb reflectance" [ 0.14 0.09 0.68 ]
MakeNamedMaterial "Light"
    "string type" [ "diffuse" ]
    "rgb reflectance" [ 0 0 0 ]

NamedMaterial "Floor"
Shape "bilinearmesh"
    "point3 P" [ 0 0 0   555 0 0   0 0 555   555 0 555 ]
    "point2 uv" [ 0 0  1 0  0 1  1 1 ] 

NamedMaterial "Ceiling"
Shape "bilinearmesh"
    "point3 P" [ 0 555 0   555 555 0   0 555 555   555 555 555 ]
    "point2 uv" [ 0 0  1 0  0 1  1 1 ]

NamedMaterial "LeftWall"
Shape "bilinearmesh"
    "point3 P" [ 0 0 0   0 555 0   0 0 555   0 555 555 ]
    "point2 uv" [ 0 0  1 0  0 1  1 1 ] 

NamedMaterial "RightWall"
Shape "bilinearmesh"
    "point3 P" [ 555 0 0   555 555 0   555 0 555   555 555 555 ]
    "point2 uv" [ 0 0  1 0  0 1  1 1 ] 

NamedMaterial "BackWall"
Shape "bilinearmesh"
    "point3 P" [ 0 0 555   555 0 555   0 555 555   555 555 555 ]
    "point2 uv" [ 0 0  1 0  0 1  1 1 ] 

AttributeBegin
    AreaLightSource "diffuse"
        "rgb L" [ 17 12 4 ]
    NamedMaterial "Light"
    Shape "bilinearmesh"
        "point3 P" [ 213 554 213   343 554 213   213 554 343   343 554 343 ]
        "point2 uv" [ 0 0  1 0  0 1  1 1 ] 
AttributeEnd

AttributeBegin
	MakeNamedMedium "foo"
        "rgb sigma_a" [ .001 .001 .001 ]
	    "rgb sigma_s" [ .015 .015 .015 ]
	    "string type" [ "homogeneous" ]
AttributeEnd

AttributeBegin
	MediumInterface "foo" ""
	Material "interface"
	Translate 278 278 278
	Shape "sphere" "float radius" 100
AttributeEnd
