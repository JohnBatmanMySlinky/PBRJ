Integrator "bdpt" "integer maxdepth" [ 6 ]
#Sampler "independent" "integer pixelsamples" [ 64 ]
Sampler "sobol" "integer pixelsamples" [ 64 ]

Film "image" 
    "integer yresolution" [ 500 ] 
    "integer xresolution" [ 500 ]
    "string filename" [ "party-blob-pbrtv3.png" ]

LookAt 4 4 4  
       0 1 0 
       0 1 0 
Camera "perspective" "float fov" [ 37 ]


WorldBegin

# Materials
MakeNamedMaterial "Floor"
    "string type" [ "matte" ]
    "rgb L" [ 0.725 0.71 0.68 ]

# Geometry
NamedMaterial "Floor"
Shape "trianglemesh"
      "integer indices" [0 1 2 0 2 3]
      "point P" [ -10 0 -10   10 0 -10   10 0 10   -10 0 10 ]


AttributeBegin
    AreaLightSource "diffuse"
        "rgb L" [ .3 .3 1.3 ]
    Scale 1.0 1.4 1.0
    Shape "sphere"
        "float radius" [ 1.0 ]
AttributeEnd

WorldEnd