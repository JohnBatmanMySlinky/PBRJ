Integrator "bdpt" "integer maxdepth" [ 6 ]
#Sampler "independent" "integer pixelsamples" [ 64 ]
Sampler "sobol" "integer pixelsamples" [ 64 ]

Film "rgb"
    "string filename" [ "party-blob-pbrtv3.png" ]
    "integer yresolution" [ 500 ]
    "integer xresolution" [ 500 ]

LookAt 4 4 4  
       0 1 0 
       0 1 0 
Camera "perspective" "float fov" [ 37 ]


WorldBegin

# Materials
MakeNamedMaterial "Floor"
    "string type" [ "diffuse" ]
    "rgb reflectance" [ 0.725 0.71 0.68 ]

# Geometry
NamedMaterial "Floor"
Shape "bilinearmesh"
    "point3 P" [ -10 0 -10   10 0 -10   -10 0 10   10 0 10 ]
    "point2 uv" [ 0 0  1 0  0 1  1 1 ] 


AttributeBegin
    AreaLightSource "diffuse"
        "rgb L" [ .3 .3 1.3 ]
    NamedMaterial "Light"
    Shape "sphere"
        "float radius" [ 1.0 ]
AttributeEnd

WorldEnd