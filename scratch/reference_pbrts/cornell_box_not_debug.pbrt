LookAt 278 278 -800   278 278 0   0 1 0
Camera "perspective" "float fov" [40]
Film "image"  "integer xresolution" [250] "integer yresolution" [250] "string filename" "a_pbrt.exr"

Sampler "random" "integer pixelsamples" [1]

Integrator "bdpt"

WorldBegin

# REFRESHER ON HOW TO TRIANGLE
# MIN = 213, 213
# MAX = 343, 343
# [Pnt3(MIN.x, k, MIN.y), Pnt3(MAX.x, k, MAX.y), Pnt3(MIN.x, k, MAX.y), Pnt3(MAX.x, k, MIN.y)],
# BE REALLY CAREFUL OF YOUR WINDING ORDER
# [1,2,3,1,4,2],

# AREA LIGHT
AttributeBegin
Material "matte" "color Kd" [1 1 1]
AreaLightSource "area"  "color L" [200 200 200] "integer nsamples" [80]
Translate 0 525 0 
Shape "sphere" "float radius" [25]

AttributeEnd


# Floor
AttributeBegin
Material "matte" "color Kd" [0.75 0.75 0.75]
Shape 
    "trianglemesh" 
    "point P" [0 0 0   555 0 555   0 0 555   555 0 0] 
    "integer indices" [0 1 2 0 3 1]
AttributeEnd

# Ceiling
AttributeBegin
Material "matte" "color Kd" [0.75 0.75 0.75]
Shape 
    "trianglemesh" 
    "point P" [0 555 0   555 555 555   0 555 555   555 555 0] 
    "integer indices" [0 1 2 0 3 1]
AttributeEnd

